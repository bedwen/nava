      "toolName": "set_alarm",
      "regexPattern": "^(?:yarin )?(?:(sabah|aksam|gece) )?(?:saat )?(\\d{1,2})(?:'?(?:a|e|ya|ye))?(?: icin)? (?:([a-z0-9]{1,24}) )?alarmi? (?:kur|ekle|ayarla)$",
