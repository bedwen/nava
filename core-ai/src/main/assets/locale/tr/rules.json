  "patterns": [
    {
      "patternId": "tr_set_alarm_hhmm_period",
      "toolName": "set_alarm",
      "regexPattern": "^(?:yarin )?(?:(sabah|aksam|gece) )?(?:saat )?(\\d{1,2})[:.](\\d{2})(?:'?(?:a|e|ya|ye))?(?: icin)? (?:([a-z0-9]{1,24}) )?alarmi? (?:kur|ekle|ayarla)$",
      "slotMappings": {
        "period_keyword": "1",
        "hour": "2",
        "minute": "3",
        "label": "4"
      },
      "staticSlots": {},
      "priority": 120
    },
    {
