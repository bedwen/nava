  "patterns": [
    {
      "patternId": "tr_set_alarm_hhmm_period",
      "toolName": "set_alarm",
      "regexPattern": "^(?:(sabah|aksam|gece) )?(?:saat )?(\\d{1,2}):(\\d{2})(?: icin)? (?:([a-z0-9]{1,24}) )?alarmi? (?:kur|ekle|ayarla)$",
      "slotMappings": {
        "period_keyword": "1",
        "hour": "2",
        "minute": "3",
        "label": "4"
      },
      "staticSlots": {},
      "priority": 120
    },
    {
      "patternId": "tr_set_alarm_hour_period",
      "toolName": "set_alarm",
      "regexPattern": "^(?:(sabah|aksam|gece) )?(?:saat )?(\\d{1,2})(?: icin)? (?:([a-z0-9]{1,24}) )?alarmi? (?:kur|ekle|ayarla)$",
      "slotMappings": {
        "period_keyword": "1",
        "hour": "2",
        "label": "3"
      },
      "staticSlots": {},
      "priority": 110
    },
    {
      "patternId": "tr_set_timer_labeled",
      "toolName": "set_timer",
      "regexPattern": "^(\\d{1,4}) (saniye|dakika|dk|saat)(?:lik|luk)? ([a-z0-9]{1,24}) (?:icin )?zamanlayici (?:kur|baslat|ayarla)$",
      "slotMappings": {
        "duration_value": "1",
        "duration_unit": "2",
        "label": "3"
      },
      "staticSlots": {},
      "priority": 120
    },
    {
      "patternId": "tr_set_timer",
      "toolName": "set_timer",
      "regexPattern": "^(\\d{1,4}) (saniye|dakika|dk|saat)(?:lik|luk)? zamanlayici (?:kur|baslat|ayarla)$",
      "slotMappings": {
        "duration_value": "1",
        "duration_unit": "2"
      },
      "staticSlots": {},
      "priority": 110
    },
    {
      "patternId": "tr_set_dnd_enable",
      "toolName": "set_dnd",
      "regexPattern": "^(?:rahatsiz etme|sessiz)(?: modunu)? (?:ac|etkinlestir|baslat)$",
      "slotMappings": {},
      "staticSlots": {
        "enabled": "true"
      },
      "priority": 110
    },
    {
      "patternId": "tr_set_dnd_disable",
      "toolName": "set_dnd",
      "regexPattern": "^(?:rahatsiz etme|sessiz)(?: modunu)? (?:kapat|devre disi birak|durdur)$",
      "slotMappings": {},
      "staticSlots": {
        "enabled": "false"
      },
      "priority": 110
    },
    {
      "patternId": "tr_set_volume",
      "toolName": "set_volume",
      "regexPattern": "^(?:sesi|ses seviyesini) %?(\\d{1,3}) (?:yap|olarak ayarla|ayarla)$",
      "slotMappings": {
        "level": "1"
      },
      "staticSlots": {},
      "priority": 110
    },
    {
      "patternId": "tr_launch_app_with_suffix",
      "toolName": "launch_app",
      "regexPattern": "^([a-z0-9][a-z0-9._-]{0,30}(?: [a-z0-9._-]{1,20})?) uygulamasini (?:ac|baslat|calistir)$",
      "slotMappings": {
        "app_name": "1"
      },
      "staticSlots": {},
      "priority": 105
    },
    {
      "patternId": "tr_launch_app",
      "toolName": "launch_app",
      "regexPattern": "^([a-z0-9][a-z0-9._-]{0,30}(?: [a-z0-9._-]{1,20})?) (?:ac|baslat|calistir)$",
