  "conversationalPatterns": [
    {
      "patternId": "tr_greeting",
      "regexPattern": "^(?:merhaba|selam|selamlar|gunaydin|iyi gunler|iyi aksamlar|iyi geceler)(?: nava)?[.!?]?$",
