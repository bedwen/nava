      "priority": 100
    },
    {
      "patternId": "tr_thanks",
      "regexPattern": "^(?:tesekkurler|tesekkur ederim|sag ol|sagol|eyvallah)(?: nava)?[.!?]?$",
      "replyText": "Rica ederim. Başka bir konuda yardımcı olabilir miyim?",
      "priority": 100
    }
