{
  "languageTag": "tr",
  "version": 1,
  "timeKeywords": {
    "sabah": "am",
    "aksam": "pm",
    "gece": "pm",
    "ogle": "12:00",
    "gece yarisi": "00:00",
    "saniye": "1",
    "dakika": "60",
